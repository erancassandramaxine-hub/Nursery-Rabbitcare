# Local Node: default below. Docker Compose (api service): mongodb://mongo:27017/arduino_iot
MONGO_URI=mongodb://127.0.0.1:27017/arduino_iot
# Windows: COM7. Linux container/host: often /dev/ttyUSB0
SENSOR_PORT=COM7
# Set to 1 only when a controller is wired; leave empty to run API without serial
IS_CONTROLLER_CONNECTED=
SENSOR_BAUD_RATE=9600
SENSOR_SAVE_INTERVAL_MS=60000
SENSOR_ID=DHT11_01
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong
JWT_SECRET=super-secret-change-me

